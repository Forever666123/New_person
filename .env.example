# ---- 必填 ----
# Discord 机器人 Token（Discord Developer Portal -> Bot -> Reset Token）
DISCORD_BOT_TOKEN=
# Anthropic API Key（anthropic SDK 会自动读取这个环境变量）
ANTHROPIC_API_KEY=
# 你自己的 Discord 用户 ID（开启开发者模式后右键头像 -> 复制用户 ID）
OWNER_DISCORD_USER_ID=

# ---- 可选 ----
# 允许和人物聊天的其他用户 ID，逗号分隔；默认只有 OWNER
ALLOWED_USER_IDS=
# 人物主动发消息时使用的频道 ID；留空则私聊 OWNER
PROACTIVE_CHANNEL_ID=
# 使用的 Claude 模型与思考强度
NEWPERSON_MODEL=claude-opus-5
NEWPERSON_EFFORT=medium
# 人设文件与照片目录
PERSONA_PATH=persona/persona.yaml
PHOTOS_INDEX=persona/photos/index.yaml
DB_PATH=data/newperson.db
# 调试用：把所有"等待时间"按比例缩短，例如 0.01 表示 1 小时变 36 秒
DELAY_SCALE=1.0
LOG_LEVEL=INFO
# 可选：外部图片生成命令，{prompt} 与 {out} 会被替换；命令需把图片写到 {out}
# IMAGE_GEN_COMMAND=python scripts/gen_image.py --prompt "{prompt}" --out "{out}"
