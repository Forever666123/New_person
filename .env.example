# ---- 必填 ----
# Discord 机器人 Token（Developer Portal -> Bot -> Reset Token）
# 注意：还要在同一页打开 MESSAGE CONTENT INTENT，否则机器人收到的消息内容永远是空的
DISCORD_BOT_TOKEN=
# Anthropic API Key（anthropic SDK 会自动读这个变量）
ANTHROPIC_API_KEY=
# 你自己的 Discord 用户 ID（开启开发者模式后右键头像 -> 复制用户 ID）
# 机器人只和你说话；你必须和它在同一个服务器里，否则私聊发不出去
OWNER_DISCORD_USER_ID=

# ---- 可选 ----
# 把某个频道也当成同一段对话；留空则只在私聊里
PROACTIVE_CHANNEL_ID=
# 模型与思考强度（effort: low / medium / high / xhigh / max）
NEWPERSON_MODEL=claude-opus-5
NEWPERSON_EFFORT=medium
# 每天最多调用多少次模型，超了就当"今天没怎么看手机"，不会崩
MAX_CALLS_PER_DAY=200

PERSONA_PATH=persona/persona.yaml
PHOTOS_INDEX=persona/photos/index.yaml
DB_PATH=data/newperson.db

# 调试用：把所有等待时间按比例缩短。0.01 表示一小时变三十六秒
DELAY_SCALE=1.0
LOG_LEVEL=INFO
