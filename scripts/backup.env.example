# 备份配置。复制成 scripts/backup.env 再改。这个文件不进 git。
#
# 先做两件事：
#
# 1) 配好 rclone 的远端（Backblaze B2 免费 10 GB，我们一年才用 2 MB）
#      rclone config
#      n) new remote -> 名字填 b2 -> 选 Backblaze B2 -> 填 keyID 和 applicationKey
#    然后在 B2 网站上建一个私有 bucket。
#    验一下：rclone lsd b2:
#
# 2) 生成加密口令，**同时抄一份到你的密码管理器里**
#      openssl rand -base64 32 > /root/.chloe-backup-pass
#      chmod 600 /root/.chloe-backup-pass
#    口令跟备份存在同一台服务器上是没有意义的：服务器没了两个一起没，
#    那些备份就是一堆你自己也打不开的乱码。

# 传到哪。注意结尾那个斜杠。
RCLONE_REMOTE=b2:chloe-backup-7490/

# 加密口令文件
GPG_PASSPHRASE_FILE=/root/.chloe-backup-pass

# ---- 跑法 ----
# 取快照只需要一个能 import newperson 的 Python，跟她是怎么起来的无关。
PYTHON_BIN=/opt/New_person/.venv/bin/python
DB_PATH=/opt/New_person/data/newperson.db

# 容器部署的话把上面两行换成（PYTHON_BIN 允许是多词命令）：
#   PYTHON_BIN="docker compose exec -T newperson python"
#   DB_PATH=/app/data/newperson.db

# systemd 的服务名，restore.sh --install 停起服务用
SERVICE_NAME=chloe

# cron 的 PATH 通常只有 /usr/bin:/bin。rclone 装在 /usr/local/bin 的话取消注释：
# PATH=/usr/local/bin:/usr/bin:/bin

# ---- 保留策略 ----
# 远端留几天。一天一份 2 MB，留一年也才 700 MB，
# 但留太久价值不大——出事你一般一周内就发现了。
KEEP_DAYS=30

# 本地留几份。防的是"手滑删了数据库"，不算异地备份。
KEEP_LOCAL=3
